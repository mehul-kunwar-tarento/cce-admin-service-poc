# Local environment settings for docker-compose.yml and the scripts in local/.
# Copy to .env and fill in every value:   cp .env.example .env
# .env is in .gitignore. Never commit real passwords.

# Postgres: database, user and password the container creates on first start
POSTGRES_DB=admin_service
POSTGRES_USER=admin_service
POSTGRES_PASSWORD=

# Keycloak admin console login (master realm, http://localhost:8180)
KEYCLOAK_ADMIN_USER=admin
KEYCLOAK_ADMIN_PASSWORD=

# Password for the test user "superadmin" (set by local/create-superadmin.sh)
SUPERADMIN_PASSWORD=

# Secret of the Keycloak client "cce-admin-service" (its service account)
KEYCLOAK_CLIENT_SECRET=
